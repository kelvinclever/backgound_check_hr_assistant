# REQUIRED (min 16 chars each). Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
HR_API_KEY=

# Optional
DATABASE_URL=sqlite:///./background_agent.db
# Fernet key for PII-at-rest encryption. If empty, one is derived from SECRET_KEY
# (then rotating SECRET_KEY makes stored PII unreadable). Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
UPLOAD_DIR=./uploads
